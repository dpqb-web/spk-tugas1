doctype html
html(lang="en", dir="ltr")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, height=device-height, initial-scale=1")
    meta(name="X-UA-Compatible", content="IE=edge")
    meta(name="application-name", content=name)
    meta(name="description", content=description)
    meta(name="generator", content="deno, coffee, pug, sass")
    meta(name="author", content=author)
    title=name
    :sass
      // Reset //

      *
        margin: 0
        padding: 0
        border: 0
        outline: 0
        font-size: 100%
        background: #0000
        box-sizing: border-box

      [hidden]
        display: none !important

      input, button, textarea
        background: inherit
        font: inherit
        color: inherit
    :sass
      @use "sass:color"

      /*  #000
          #1A1A1A
          #333
          #7F7F7F
          #CCC
          #E6E6E6
          #FFF
      /*  #333
          #777
          #BBB
          #FFF

      =dark
        @media (prefers-color-scheme: dark)
          body.auto
            @content
        body.dark
          @content

      // Dasar //

      a, :link, :visited, :any-link
        color: inherit
        cursor: pointer
        text-decoration:
          thickness: 1px
          style: dotted
          color: #0000007f
          line: underline

        &:hover
          text-decoration:
            style: solid
            color: #000

      @for $i from 1 through 6
        h#{7 - $i}
          font:
            size:  + (3 * $i)
            weight: 400
          margin-block-end: 1rem
          line-height: 1.3

      // Isi //
      body
        display: flex
        min-height: 100vh
        font-family: Inter, sans-serif
        font-feature-settings: 'tnum'
        font-variant-alternates: styleset(disambiguation)
        color: #000
        background: #e6e6e6
        user-select: none

      main
        max-width: 480px
        margin: auto
        width: 100%
        display: flex
        flex-flow: column nowrap
        aspect-ratio: 1

        .counter
          font-size: 5em
          margin: 10px
          text-align: right
          line-height: 1

        .buttons
          display: flex
          flex-flow: row nowrap
          flex: 1

          > *
            width: 50%

          .smalls
            display: flex
            flex-flow: column nowrap

            > *
              height: 50%

        button
          border-radius: 10px
          background: #ccc
          margin: 10px

          i
            font-size: 4em
            margin: auto

      aside
        position: absolute
        top: 0
        left: 0
        z-index: 99

        button
          padding: 12px
          border: 1px solid #7f7f7f
          background: #1a1a1a

          i
            font-size: 2em

      button
        border: 1px solid #7f7f7f
        &:active
          filter: invert(100%)

      .dialog
        position: fixed
        top: 0
        left: 0
        width: 100%
        height: 100%
        background: #0000007f
        backdrop-filter: blur(5px)
        z-index: 9999
        display: flex

        .box
          max-width: 480px
          margin: auto

      i
        &.bx, &.bxf, &.bxl
          display: block

      +dark
        color: #fff
        background: #1a1a1a

        main button
          background: #333
    :coffee
      self.g =
        vibrate: (ms) ->
          if 'vibrate' of navigator
            navigator.vibrate ms
  body
    table
      thead
        tr
          th(rowspan='2') No.
          th(rowspan='2') Nama Alternatif
          th Harga
          th Jangka ketersediaan
          th Tingkat keamanan
          th Kapasitas RAM
          th Kapasitas penyimpanan
        tr
          th Cost
          th Benefit
          th Benefit
          th Benefit
          th Benefit
      tbody
