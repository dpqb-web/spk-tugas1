- const name = names[0] + ' - ' + names[1];
- const description = `Aplikasi ${names[0]} bertema ${names[1]}`;

doctype html
html(lang="id", dir="ltr")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, height=device-height, initial-scale=1")
    meta(name="X-UA-Compatible", content="IE=edge")
    meta(name="application-name", content=names[0])
    meta(name="description", content=description)
    meta(name="generator", content="deno, coffee, pug, sass")
    meta(name="author", content=author)
    title=names[1]
    :sass
      // Reset //

      *
        margin: 0
        padding: 0
        border: 0
        outline: 0
        font-size: 100%
        background: #0000
        box-sizing: border-box

      [hidden]
        display: none !important

      input, textarea, button, select
        background: inherit
        font: inherit
        color: inherit
    style.
      @font-face{font-family:InterVariable;font-style:normal;font-weight:100 900;font-display:swap;src:url('data:font/woff2;base64,#{fonts[0]}') format('woff2')}@font-face{font-family:InterVariable;font-style:italic;font-weight:100 900;font-display:swap;src:url('data:font/woff2;base64,#{fonts[1]}') format('woff2')}@font-feature-values InterVariable{@character-variant{cv01:1;cv02:2;cv03:3;cv04:4;cv05:5;cv06:6;cv07:7;cv08:8;cv09:9;cv10:10;cv11:11;cv12:12;cv13:13;alt-1:1;alt-3:9;open-4:2;open-6:3;open-9:4;lc-l-with-tail:5;simplified-u:6;alt-double-s:7;uc-i-with-serif:8;uc-g-with-spur:10;single-story-a:11;compact-lc-f:12;compact-lc-t:13}@styleset{ss01:1;ss02:2;ss03:3;ss04:4;ss05:5;ss06:6;ss07:7;ss08:8;open-digits:1;disambiguation:2;disambiguation-except-zero:4;round-quotes-and-commas:3;square-punctuation:7;square-quotes:8;circled-characters:5;squared-characters:6}}
    :sass
      @use "sass:color"
      @use "sass:math"

      /*  #000
          #1A1A1A
          #333
          #7F7F7F
          #CCC
          #E6E6E6
          #FFF
      /*  #333
          #777
          #BBB
          #FFF

      =dark
        @media (prefers-color-scheme: dark)
          body.auto
            @content
        body.dark
          @content

      // Dasar //

      a, :link, :visited, :any-link
        color: currentColor
        cursor: pointer
        text-decoration:
          thickness: 1px
          style: dotted
          color: #0000007f
          line: underline

        &:hover
          text-decoration:
            style: solid
            color: #000

      @for $i from 1 through 6
        h#{7 - $i}
          font:
            size: 1em + math.div($i - 1, 5)
            weight: 300
          margin-block-end: 1rem
          line-height: 1.5

      // Isi //
      html
        font-size: math.div(13em, 16)

      body
        margin: auto
        width: calc(100vw * (30 / 32))
        min:
          width: 480px
          height: 100vh
        font:
          family: InterVariable, sans-serif
          feature-settings: 'tnum'
          variation-settings: 'opsz' 32
          variant-alternates: styleset(disambiguation)
        line-height: 1.3
        color: #000
        background: #e6e6e6
        user-select: none

      input, textarea, button, select
        border: 1px solid #1A1A1A
        border-radius: 5px
        padding: 3px 5px
        
      input, textarea
        background: #FFF
        &:focus
          border-color: #1a7fe6

      button, select
        background: #CCC
        &:active
          filter: invert(1)

      section
        margin: calc(100vw * (30 / 32) * (1 / 12) * (1 / 8))

      h1
        margin: calc(100vw * (30 / 32) * (1 / 12) * (1 / 8))

      table
        width: 100%
        border-collapse: collapse
        
        th, td
          padding: 0.5em
          border: 1px solid #7F7F7F

        input
          width: 100%

      // Khusus //
      .actStep1
        margin-bottom: 1rem

      td [class^="acts"]
        display: flex
        flex-flow: row nowrap
        gap: 5px
    :coffee
      String::toCapital1st = -> @charAt(0).toUpperCase() + @slice 1

      document.addEventListener 'contextmenu', (e) -> e.preventDefault()
    :coffee
      # TEMP: can't use it rn cuz fuck Fedora
      # @data =
      #   alt: select 'alt'
      #   criteria: select 'criteria'

      # TEMP: fallback for code above. will be deleted when code above works
      @data =
        alt: JSON.parse '[{"name":"Amazon Web Services","values":[{"name":"price","value":10},{"name":"memory","value":4},{"name":"storage","value":80},{"name":"uptime","value":100},{"name":"security","value":3}]},{"name":"Google Cloud Platform","values":[{"name":"price","value":15},{"name":"memory","value":8},{"name":"storage","value":160},{"name":"uptime","value":90},{"name":"security","value":2}]},{"name":"Microsoft Azure","values":[{"name":"price","value":20},{"name":"memory","value":16},{"name":"storage","value":200},{"name":"uptime","value":80},{"name":"security","value":3}]}]'
        criteria: JSON.parse '[{"name":"price","nameL10N":"Harga","type":"cost","weight":0.2},{"name":"memory","nameL10N":"Memori","type":"benefit","weight":0.2},{"name":"storage","nameL10N":"Penyimpanan","type":"benefit","weight":0.2},{"name":"uptime","nameL10N":"Ketersediaan","type":"benefit","weight":0.2},{"name":"security","nameL10N":"Keamanan","type":"benefit","weight":0.2}]'
    :coffee
      document.addEventListener 'DOMContentLoaded', =>
        for tbl in document.querySelectorAll 'table'
          thName = tbl.querySelectorAll 'tr.insideName'
          thType = tbl.querySelectorAll 'tr.insideType'
          thWght = tbl.querySelectorAll 'tr.insideWeight'

          for crit in @data.criteria
            name = document.createElement 'th'
            name.textContent = crit.nameL10N
            x.appendChild name for x in thName

            type = document.createElement 'th'
            type.textContent = crit.type.toCapital1st()
            x.appendChild type for x in thType

            wght = document.createElement 'th'
            wght.textContent = crit.weight * 100 + '%'
            x.appendChild wght for x in thWght
    :coffee
      document.addEventListener 'DOMContentLoaded', =>
        tblContent = document.querySelector '#step1 table tbody'

        thAct = document.createElement 'th'
        thAct.rowSpan = 3
        thAct.textContent = 'Tindakan'
        document.querySelector '#step1 .insideName'
        .appendChild thAct

        for alt, i in @data.alt
          if alt.values.length is @data.criteria.length
            last = 0

            row = document.createElement 'tr'
            row.dataset.name = alt.name

            cols = (document.createElement 'td' for _ in [1..(@data.criteria.length + 3)])

            cols[0].textContent = i + 1

            do ->
              name = document.createElement 'span'
              name.textContent = alt.name
              cols[1].appendChild name

              input = document.createElement 'input'
              input.hidden = true
              input.name = 'name'
              input.value = alt.name
              cols[1].appendChild input

            for x, y in alt.values
              last = y + 2

              value = document.createElement 'span'
              value.textContent = x.value
              cols[last].appendChild value

              input = document.createElement 'input'
              input.hidden = true
              input.type = 'number'
              input.name = x.name
              input.value = x.value
              input.min = 0
              cols[last].appendChild input

            acts = document.querySelector '.DOM .altActs'
            cols[last + 1].innerHTML = acts.innerHTML

            row.appendChild col for col in cols
            tblContent.appendChild row
    :coffee
      document.addEventListener 'DOMContentLoaded', =>
        tblContent = document.querySelector '#step2 table tbody'
        for alt, i in @data.alt
          if alt.values.length is @data.criteria.length
            row = document.createElement 'tr'

            cols = (document.createElement 'td' for _ in [1..(@data.criteria.length + 2)])

            cols[0].textContent = i + 1
            cols[1].textContent = alt.name

            # TODO: do the matrix scores thing

            row.appendChild col for col in cols
            tblContent.appendChild row
    :coffee
      document.addEventListener 'DOMContentLoaded', =>
        tblContent = document.querySelector '#step3 table tbody'
        for alt, i in @data.alt
          if alt.values.length is @data.criteria.length
            row = document.createElement 'tr'

            cols = (document.createElement 'td' for _ in [1..4])

            cols[0].textContent = i + 1
            cols[1].textContent = alt.name

            # TODO: normalize the matrix and rank it

            row.appendChild col for col in cols
            tblContent.appendChild row

        trSum = document.createElement 'tr'
        tdSum = document.createElement 'td'
        tdSum.colSpan = 2
        tdSum.textContent = 'Jumlah'
        tblContent.appendChild trSum.appendChild tdSum
    :coffee
      # TODO: add the function to add, edit, remove alternative; and update the tables everytime. use `Webview`'s binds to save it to JSON cache
  body
    h1=names[1]
    section#step1
      h2 Data Alternatif
      .actStep1
        button(name='alt-add-start') Tambah Alternatif
        // SOON!
        button(name='criteria-modify-start', hidden) Ubah Kriteria
      table
        thead
          tr.insideName
            th(rowspan='3') No.
            th(rowspan='3') Nama Alternatif
          tr.insideType
          tr.insideWeight
        tbody
    section#step2
      h2 Vektor
      table
        thead
          tr.insideName
            th(rowspan='3') No.
            th(rowspan='3') Nama Alternatif
          tr.insideType
          tr.insideWeight
        tbody
    section#step3
      h2 Peringkat
      table
        thead
          th No.
          th Nama Alternatif
          th Jumlah Vektor
          th Peringkat
        tbody
    .DOM(hidden)
      .altActs
        .actsInit
          button(name='alt-edit-start') Sunting
          button.red(name='alt-del-start') Hapus
        .actsEdit(hidden)
          button.green(name='alt-edit-accept') Simpan
          button.red(name='alt-edit-cancel') Batal
        .actsDel(hidden)
          button.red(name='alt-del-accept') Hapus
          button(name='alt-del-cancel') Batal
